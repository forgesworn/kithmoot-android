<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      A test-only external signer. It lives in the instrumentation APK, which
      Android installs as a different package from KithMoot. This lets G5 use
      the real NIP-55 intent/result boundary without introducing a signer into
      the production application.
    -->
    <application android:allowAudioPlaybackCapture="true">
        <activity android:name="dev.forgesworn.kithmoot.media.PlaybackToneActivity" android:exported="true" />
    </application>
</manifest>
