<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      A test-only external signer. It lives in the instrumentation APK, which
      Android installs as a different package from KithMoot. This lets G5 use
      the real NIP-55 intent/result boundary without introducing a signer into
      the production application.
    -->
    <application android:allowAudioPlaybackCapture="true">
        <activity android:name="dev.forgesworn.kithmoot.drawing.DrawingTargetActivity" android:label="Drawing test target" android:exported="true" android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="dev.forgesworn.kithmoot.media.PlaybackToneActivity" android:exported="true" />
        <!-- A test-only NIP-55 content provider, so the silent path crosses a real ContentResolver into another package. -->
        <provider android:name="dev.forgesworn.kithmoot.account.FixtureSilentSignerProvider"
            android:authorities="dev.forgesworn.kithmoot.test.NIP44_DECRYPT"
            android:exported="true" />
    </application>
</manifest>
