<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The G5 fixture control socket is reversed to loopback and exists only
         in debug builds. Production retains its ordinary transport policy. -->
    <application android:usesCleartextTraffic="true">
        <!-- Host for createComposeRule() in instrumented Compose tests, the
             same entry ui-test-manifest would add, without the dependency. -->
        <activity android:name="androidx.activity.ComponentActivity" android:exported="false" />
        <activity android:name="dev.forgesworn.kithmoot.media.recording.RecordingRecipientFixtureActivity"
            android:exported="false" android:process=":recordingRecipientFixture"
            android:launchMode="singleTask" android:configChanges="keyboardHidden|orientation|screenSize" />
    </application>
</manifest>
